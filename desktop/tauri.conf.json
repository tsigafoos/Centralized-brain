{
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../src-tauri/target/frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Centralized Brain",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "fullscreen": false,
        "resizable": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "http": {
        "all": false,
        "scope": [
          "http://127.0.0.1:9000/*",
          "http://localhost:9000/*"
        ]
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.centralized-brain.desktop"
    },
    "updater": {
      "active": false
    }
  }
}
