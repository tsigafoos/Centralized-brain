# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=9000

# OpenAI-compatible endpoint (your local inference server)
OPENAI_ENDPOINT=http://127.0.0.1:8001

# Voice Backend: "local" (default, completely offline) or "google" (requires credentials)
VOICE_BACKEND=local

# Storage path for tasks and sessions
STORAGE_PATH=./data

# Optional: Voxtral TTS (text-to-speech) API key for mobile voice synthesis
# Get free credits from https://mistral.ai/
# VOXTRAL_API_KEY=your-mistral-api-key

# Optional: Firebase configuration (for cloud sync)
# FIREBASE_PROJECT_ID=your-project-id

# Optional: Google Cloud credentials (only needed if VOICE_BACKEND=google)
# GOOGLE_CLOUD_CREDENTIALS=/path/to/credentials.json
